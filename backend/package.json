{
  "name": "backend",
  "version": "0.0.1",
  "description": "Backend API FarmSight untuk Toko Farm Berkah",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23",
    "npm": ">=11.12.1 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma.config.ts\" \"vitest.config*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"prisma.config.ts\" \"vitest.config*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/ prisma.config.ts vitest.config.ts vitest.config.e2e.ts",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:cov": "vitest run --coverage --config ./vitest.config.ts",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --config ./vitest.config.ts",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:test": "node scripts/migrate-test-database.mjs",
    "env:init:local": "node scripts/init-local-env.mjs",
    "db:check:security": "node scripts/check-postgres-security.mjs",
    "db:seed:roles": "npm run build --silent && node scripts/seed-roles.mjs",
    "admin:bootstrap": "npm run build --silent && node scripts/bootstrap-super-admin.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.7",
    "joi": "18.2.9",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.1.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.4",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "overrides": {
    "mysql2": "3.24.6"
  }
}
